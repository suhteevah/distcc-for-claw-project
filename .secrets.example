# C&C Server Secrets — copy to .secrets and fill in your values
# .secrets is gitignored and never committed.

# Root password for first-boot SSH access
ROOT_PASSWORD="CHANGEME"

# WiFi credentials (required for wireless-only machines)
WIFI_SSID="YOUR_SSID"
WIFI_PASSWORD="YOUR_PASSWORD"

# SSH authorized keys (add as many SSH_PUBKEY_N as needed)
SSH_PUBKEY_1="ssh-rsa AAAA..."
SSH_PUBKEY_2="ssh-ed25519 AAAA..."

# Tailscale pre-auth key (generate at https://login.tailscale.com/admin/settings/keys)
# These expire after 90 days by default — regenerate as needed.
TS_AUTH_KEY="tskey-auth-CHANGEME"

# ── Anthropic auth — pick ONE of the two options below ──────────────────────
#
# Option A: OAuth via Claude Max (preferred — bills against your Max plan)
# 1. On a workstation, run: claude
# 2. Complete the browser login flow, then quit. Writes ~/.claude/.credentials.json
# 3. Point CLAUDE_CREDENTIALS_FILE at that file (or use scripts/claude-oauth-deploy.sh)
# 4. Leave ANTHROPIC_API_KEY empty.
CLAUDE_CREDENTIALS_FILE=""
#
# Option B: API key (pay-as-you-go) — leave both empty to use Ollama only.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
#
# Default model on this fleet.
# claude-opus-4-7   = current Opus (best, slowest, most expensive)
# claude-sonnet-4-6 = balanced
# claude-haiku-4-5  = fast/cheap
ANTHROPIC_MODEL="claude-opus-4-7"

# Discord bot token — needed for MailClaw/OpenClaw Discord integration
# Create a bot at: https://discord.com/developers/applications
# Bot → Reset Token → copy. Enable Message Content Intent under Privileged Gateway Intents.
DISCORD_BOT_TOKEN=""
