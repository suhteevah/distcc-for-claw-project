#!/bin/sh /etc/rc.common
USE_PROCD=1
START=86
STOP=10
start_service() {
  [ -f /etc/mesh-agent.env ] && . /etc/mesh-agent.env
  procd_open_instance
  procd_set_param command /usr/sbin/mesh-agent
  procd_set_param env MESH_AGENT_NODE="$MESH_AGENT_NODE" MESH_AGENT_NATS="$MESH_AGENT_NATS" \
    MESH_AGENT_ALLOW_RAW="${MESH_AGENT_ALLOW_RAW:-0}" MESH_AGENT_ALLOW_REBOOT="${MESH_AGENT_ALLOW_REBOOT:-0}" \
    RUST_LOG="${RUST_LOG:-info}"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
