#!/bin/sh /etc/rc.common
# procd init for nats-server (fleet messaging fabric, P2)
USE_PROCD=1
START=85
STOP=10

start_service() {
  procd_open_instance
  procd_set_param command /usr/sbin/nats-server -c /etc/nats/nats.conf
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param pidfile /var/run/nats-server.pid
  procd_close_instance
}

reload_service() {
  # nats-server supports config reload via SIGHUP
  local pid
  pid="$(cat /var/run/nats-server.pid 2>/dev/null)"
  [ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null || restart
}
