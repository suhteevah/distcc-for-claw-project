[Unit]
Description=Claude Code AgentAPI
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=claude-agent
WorkingDirectory=/home/claude-agent
# HOME must be set so the claude CLI finds ~/.claude/.credentials.json (OAuth)
Environment="HOME=/home/claude-agent"
# CI=true suppresses interactive consent prompts (theme picker, bypass-permissions warning, etc.)
Environment="CI=true"
# `-` prefix = optional file; supports both API-key auth and OAuth (empty file)
EnvironmentFile=-/etc/claude/api-key
EnvironmentFile=-/etc/claude/model-env
ExecStart=/usr/local/bin/agentapi server --type claude -- claude \
  --permission-mode dontAsk \
  --max-budget-usd 10.00
Restart=always
RestartSec=10
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-agentapi

[Install]
WantedBy=multi-user.target
